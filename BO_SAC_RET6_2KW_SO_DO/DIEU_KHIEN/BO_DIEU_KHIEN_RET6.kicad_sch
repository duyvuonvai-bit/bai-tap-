 (instances(project "BO_DIEU_KHIEN_RET6"(path "/3d252614-68a3-4203-9ffe-6393e4b489b4"(reference "C19")(unit 1)))))(wire(pts(xy 524.51 219.71)(xy 524.51 215.9))(stroke(width 0)(type default))(uuid "649c53d4-d110-42f2-a163-3bd6c9e9280e"))(label "3V3_ANALOG" (at 524.51 215.9 90)(effects(font(size 1.0 1.0))(justify left bottom))(uuid "212885ae-8466-4b1c-831b-f432036db3df"))(wire(pts(xy 524.51 227.33)(xy 524.51 231.14))(stroke(width 0)(type default))(uuid "4d158757-917e-433f-a327-13b9a50bc48d"))(label "GND_THU_CAP" (at 524.51 231.14 90)(effects(font(size 1.0 1.0))(justify left bottom))(uuid "4b671335-c412-4f54-9166-b3a12f8ff9ab"))(text "C16/C17 sat VDDA29-VSSA27; C18/C19 sat VREF+28-VSSA27." (at 420 242 0)(effects(font(size 1.15 1.15))(justify left bottom))(uuid "f454c22f-1c9a-4838-9faa-a1f880f0495f"))(text "Mat phang GND lien tuc; tach dong lon bang bo tri, khong cat mat phang duoi ADC." (at 420 248 0)(effects(font(size 1.1 1.1))(justify left bottom))(uuid "8efa823a-9936-4366-aa2e-f09ffd5e7198"))(text "LAYOUT VA THU LAN DAU" (at 15 292 0)(effects(font(size 1.8 1.8))(justify left bottom))(uuid "27954a6a-b7e7-49fb-9918-e6e97d83c8b2"))(text "1. U1 LQFP64 chan 0.5 mm: han tren PCB; khong dung day Dupont cho duong cong suat/PWM driver." (at 15 302 0)(effects(font(size 1.45 1.45))(justify left bottom))(uuid "ee4adfb3-d899-43bc-8a3f-4c5751863c9f"))(text "2. Cap 5 V gioi han dong khi CHUA noi driver/cong suat. Do 3V3, VDDA va NRST truoc khi nap." (at 15 309 0)(effects(font(size 1.45 1.45))(justify left bottom))(uuid "ecb60553-85a9-451c-9f05-077d642888c2"))(text "3. Test SWD, ADC va bon PWM bang oscilloscope. Kiem tra dead-time, khoa cung nhanh va FAULT truoc khi noi driver." (at 15 316 0)(effects(font(size 1.45 1.45))(justify left bottom))(uuid "1d912c7f-0f9f-47c1-873d-5027fe08f8cf"))(text "4. Firmware phai giu CHO_PHEP_CHAY=0 luc boot/reset/loi; chi cho chay sau khi nguon va cam bien hop le." (at 15 323 0)(effects(font(size 1.45 1.45))(justify left bottom))(uuid "74f5b92e-d49b-4cd4-9c2d-450345153363"))(text "5. Nguyen ly nay khong bao gom mach bao ve cam bien, latch loi, nguon driver, duong cong suat va PCB400V." (at 15 330 0)(effects(font(size 1.45 1.45))(justify left bottom))(uuid "7a91ed77-6eac-4289-b884-a8d869477a7a"))(text "6. Da doi chieu pin bang KiCad/ST open pin data. Chua lap rap hay do kiem thuc te; can review PCB truoc che tao." (at 15 337 0)(effects(font(size 1.45 1.45))(justify left bottom))(uuid "bcd34403-0ae2-45a4-8f7a-ca44ad34830c"))(symbol(lib_id "RET6_LOCAL:PWR_FLAG")(at 425.45 279.4 0)(unit 1)(exclude_from_sim no)(in_bom yes)(on_board yes)(dnp no)(uuid "308606d2-eb53-479f-86be-d2959f442fee")
